from awsglue.context import GlueContext
from awsglue.job import Job
from pyspark.context import SparkContext
from pyspark.sql import functions as F
from pyspark.sql.types import StructType,StructField,StringType,IntegerType

INPUT_PATH="s3://your-data-bucket/csv-folder/"
OUTPUT_PATH="s3://your-output-bucket/id-first-occurrence/"

sc=SparkContext.getOrCreate()
glue_context=GlueContext(sc)
spark=glue_context.spark_session

job=Job(glue_context)
job.init("find_first_id_occurrence",{})

schema=StructType([
    StructField("ID",StringType(),False),
    StructField("yr",IntegerType(),False),
    StructField("qtr",IntegerType(),False)
])

df=(
    spark.read
    .option("header","true")
    .schema(schema)
    .csv(INPUT_PATH)
)

clean=(
    df.select(
        F.trim("ID").alias("ID"),
        F.col("yr").cast("int").alias("yr"),
        F.col("qtr").cast("int").alias("qtr")
    )
    .filter(
        F.col("ID").isNotNull()&
        F.col("yr").isNotNull()&
        F.col("qtr").between(1,4)
    )
    .withColumn("quarter_index",F.col("yr")*4+F.col("qtr")-1)
)

first_occurrence=(
    clean.groupBy("ID")
    .agg(F.min("quarter_index").alias("first_quarter_index"))
    .select(
        "ID",
        F.floor(F.col("first_quarter_index")/4).cast("int").alias("first_yr"),
        (F.col("first_quarter_index")%4+1).cast("int").alias("first_qtr")
    )
    .withColumn(
        "first_yr_qtr",
        F.concat(
            F.col("first_yr").cast("string"),
            F.lit("-Q"),
            F.col("first_qtr").cast("string")
        )
    )
)

first_occurrence.show(20,truncate=False)

(
    first_occurrence
    .write
    .mode("overwrite")
    .partitionBy("first_yr")
    .parquet(OUTPUT_PATH)
)

job.commit()
