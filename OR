import pandas as pd
import numpy as np

def suppress_disclosure(
    df,
    threshold=10,
    table_keys=("cohort_state","yr_qtr"),
    row_col="state",
    column_col="sector",
    count_col="count",
    protected_metrics=(
        "count",
        "mean_wage",
        "median_wage",
        "percentile_25",
        "percentile_75"
    ),
    round_base=None
):
    required=set(table_keys)|{
        row_col,
        column_col,
        count_col
    }

    missing=[
        column for column in required
        if column not in df.columns
    ]

    if missing:
        raise ValueError(
            f"Missing columns: {missing}"
        )

    duplicate_columns=list(table_keys)+[
        row_col,
        column_col
    ]

    duplicates=df.duplicated(
        duplicate_columns,
        keep=False
    )

    if duplicates.any():
        duplicate_examples=(
            df.loc[
                duplicates,
                duplicate_columns
            ]
            .head(10)
            .to_dict("records")
        )

        raise ValueError(
            "Duplicate state-sector cells were found. "
            f"Aggregate them first. Examples: {duplicate_examples}"
        )

    protected=df.copy().reset_index(drop=True)

    protected[count_col]=pd.to_numeric(
        protected[count_col],
        errors="coerce"
    ).astype("Float64")

    existing_metrics=[
        metric for metric in protected_metrics
        if metric in protected.columns
    ]

    for metric in existing_metrics:
        protected[metric]=pd.to_numeric(
            protected[metric],
            errors="coerce"
        ).astype("Float64")

    protected["suppressed"]=False
    protected["suppression_type"]="published"
    protected["suppression_round"]=pd.Series(
        0,
        index=protected.index,
        dtype="Int64"
    )

    primary_mask=(
        protected[count_col].notna()
        &protected[count_col].gt(0)
        &protected[count_col].lt(threshold)
    )

    protected.loc[
        primary_mask,
        "suppressed"
    ]=True

    protected.loc[
        primary_mask,
        "suppression_type"
    ]="primary"

    protected.loc[
        primary_mask,
        "suppression_round"
    ]=1

    def smallest_available(indexes):
        candidates=[
            index for index in indexes
            if not protected.at[index,"suppressed"]
            and pd.notna(protected.at[index,count_col])
        ]

        if not candidates:
            return None

        return min(
            candidates,
            key=lambda index:(
                protected.at[index,count_col],
                index
            )
        )

    grouped=protected.groupby(
        list(table_keys),
        dropna=False,
        sort=False
    )

    for _,table in grouped:
        table_indexes=table.index.tolist()
        addition_round=1

        while True:
            additions=set()

            for dimension in (row_col,column_col):
                dimension_groups=protected.loc[
                    table_indexes
                ].groupby(
                    dimension,
                    dropna=False,
                    sort=False
                ).groups

                for indexes in dimension_groups.values():
                    indexes=list(indexes)

                    suppressed_count=sum(
                        protected.at[index,"suppressed"]
                        for index in indexes
                    )

                    if suppressed_count!=1:
                        continue

                    selected=smallest_available(indexes)

                    if selected is not None:
                        additions.add(selected)

            if not additions:
                break

            suppression_level=(
                "secondary"
                if addition_round==1
                else "tertiary"
            )

            for index in additions:
                if protected.at[index,"suppressed"]:
                    continue

                protected.at[index,"suppressed"]=True
                protected.at[
                    index,
                    "suppression_type"
                ]=suppression_level

                protected.at[
                    index,
                    "suppression_round"
                ]=addition_round+1

            addition_round+=1

            if addition_round>len(table_indexes)+1:
                raise RuntimeError(
                    "Suppression algorithm did not converge"
                )

    original_counts=protected[count_col].copy()

    state_margin_flags=(
        protected
        .groupby(
            list(table_keys)+[row_col],
            dropna=False
        )["suppressed"]
        .any()
        .rename("suppressed")
        .reset_index()
    )

    state_margin_counts=(
        protected
        .assign(_original_count=original_counts)
        .groupby(
            list(table_keys)+[row_col],
            dropna=False
        )["_original_count"]
        .sum(min_count=1)
        .rename("count")
        .reset_index()
    )

    state_margins=state_margin_counts.merge(
        state_margin_flags,
        on=list(table_keys)+[row_col],
        how="left"
    )

    state_margins["margin_type"]="state"
    state_margins["margin_value"]=(
        state_margins[row_col].astype(str)
    )

    sector_margin_flags=(
        protected
        .groupby(
            list(table_keys)+[column_col],
            dropna=False
        )["suppressed"]
        .any()
        .rename("suppressed")
        .reset_index()
    )

    sector_margin_counts=(
        protected
        .assign(_original_count=original_counts)
        .groupby(
            list(table_keys)+[column_col],
            dropna=False
        )["_original_count"]
        .sum(min_count=1)
        .rename("count")
        .reset_index()
    )

    sector_margins=sector_margin_counts.merge(
        sector_margin_flags,
        on=list(table_keys)+[column_col],
        how="left"
    )

    sector_margins["margin_type"]="sector"
    sector_margins["margin_value"]=(
        sector_margins[column_col].astype(str)
    )

    grand_margin_flags=(
        protected
        .groupby(
            list(table_keys),
            dropna=False
        )["suppressed"]
        .any()
        .rename("suppressed")
        .reset_index()
    )

    grand_margin_counts=(
        protected
        .assign(_original_count=original_counts)
        .groupby(
            list(table_keys),
            dropna=False
        )["_original_count"]
        .sum(min_count=1)
        .rename("count")
        .reset_index()
    )

    grand_margins=grand_margin_counts.merge(
        grand_margin_flags,
        on=list(table_keys),
        how="left"
    )

    grand_margins["margin_type"]="grand_total"
    grand_margins["margin_value"]="Total"

    state_margins.loc[
        state_margins["suppressed"],
        "count"
    ]=pd.NA

    sector_margins.loc[
        sector_margins["suppressed"],
        "count"
    ]=pd.NA

    grand_margins.loc[
        grand_margins["suppressed"],
        "count"
    ]=pd.NA

    margin_columns=list(table_keys)+[
        "margin_type",
        "margin_value",
        "count",
        "suppressed"
    ]

    margins=pd.concat(
        [
            state_margins[margin_columns],
            sector_margins[margin_columns],
            grand_margins[margin_columns]
        ],
        ignore_index=True
    )

    suppression_mask=protected["suppressed"]

    protected.loc[
        suppression_mask,
        existing_metrics
    ]=pd.NA

    if round_base is not None:
        if round_base<=0:
            raise ValueError(
                "round_base must be greater than zero"
            )

        published_mask=~protected["suppressed"]

        for metric in existing_metrics:
            protected.loc[
                published_mask,
                metric
            ]=(
                protected.loc[
                    published_mask,
                    metric
                ]/round_base
            ).round()*round_base

        visible_margins=~margins["suppressed"]

        margins.loc[
            visible_margins,
            "count"
        ]=(
            margins.loc[
                visible_margins,
                "count"
            ]/round_base
        ).round()*round_base

    audit=(
        protected["suppression_type"]
        .value_counts()
        .rename_axis("suppression_type")
        .reset_index(name="cells")
    )

    return protected,margins,audit
