from pathlib import Path
import json
import pandas as pd
from plotly.offline import get_plotlyjs

def create_state_sector_sankey(
    xlsx_path,
    output_html="state_sector_sankey.html",
    tabs=None
):
    metrics=[
        "count",
        "mean_wage",
        "median_wage",
        "percentile_25",
        "percentile_75"
    ]
    required=["yr_qtr","state","sector"]+metrics
    workbook=pd.ExcelFile(xlsx_path)
    selected_tabs=workbook.sheet_names if tabs is None else list(tabs)

    missing_tabs=[
        tab for tab in selected_tabs
        if tab not in workbook.sheet_names
    ]
    if missing_tabs:
        raise ValueError(f"Tabs not found: {missing_tabs}")

    frames=[]

    for tab in selected_tabs:
        df=pd.read_excel(xlsx_path,sheet_name=tab)
        missing=[
            column for column in required
            if column not in df.columns
        ]
        if missing:
            raise ValueError(
                f"Tab {tab} is missing columns: {missing}"
            )

        df=df[required].copy()
        df["cohort_state"]=str(tab)
        df["yr_qtr"]=df["yr_qtr"].astype(str)
        df["state"]=df["state"].astype(str)
        df["sector"]=df["sector"].astype(str)

        for metric in metrics:
            df[metric]=pd.to_numeric(
                df[metric],
                errors="coerce"
            )

        frames.append(df)

    data=pd.concat(frames,ignore_index=True)

    records=data.where(
        pd.notna(data),
        None
    ).to_dict("records")

    app_data=json.dumps(
        records,
        separators=(",",":"),
        allow_nan=False
    ).replace("</","<\\/")

    cohorts=json.dumps(
        [str(tab) for tab in selected_tabs],
        separators=(",",":")
    )

    html="""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cohort Sankey</title>
<script>__PLOTLY__</script>
<style>
body{font-family:Arial,sans-serif;margin:0;background:#f7f8fa;color:#202124}
header{background:#fff;border-bottom:1px solid #ddd;padding:18px 24px}
h1{margin:0 0 14px;font-size:24px}
.controls{display:flex;gap:18px;flex-wrap:wrap}
.control{display:flex;flex-direction:column;gap:5px}
label{font-size:13px;font-weight:600;color:#555}
select{min-width:165px;padding:8px;border:1px solid #bbb;border-radius:5px;background:#fff}
#chart{height:calc(100vh - 130px);min-height:600px}
</style>
</head>
<body>
<header>
<h1>Cohort Flow</h1>
<div class="controls">
<div class="control">
<label for="cohort">Cohort state</label>
<select id="cohort"></select>
</div>
<div class="control">
<label for="quarter">Quarter</label>
<select id="quarter"></select>
</div>
<div class="control">
<label for="dimension">View by</label>
<select id="dimension">
<option value="state">State</option>
<option value="sector">Sector</option>
</select>
</div>
<div class="control">
<label for="metric">Metric</label>
<select id="metric">
<option value="count">Count</option>
<option value="mean_wage">Mean Wage</option>
<option value="median_wage">Median Wage</option>
<option value="percentile_25">Percentile 25</option>
<option value="percentile_75">Percentile 75</option>
</select>
</div>
</div>
</header>
<div id="chart"></div>
<script>
const rows=__DATA__;
const cohorts=__COHORTS__;
const cohort=document.getElementById("cohort");
const quarter=document.getElementById("quarter");
const dimension=document.getElementById("dimension");
const metric=document.getElementById("metric");

cohort.innerHTML=cohorts.map(
value=>`<option value="${value}">${value}</option>`
).join("");

function naturalSort(a,b){
return a.localeCompare(
b,
undefined,
{numeric:true,sensitivity:"base"}
);
}

function colorFor(value,alpha=1){
let hash=0;
for(let i=0;i<value.length;i++){
hash=value.charCodeAt(i)+((hash<<5)-hash);
}
const hue=Math.abs(hash)%360;
return `hsla(${hue},65%,48%,${alpha})`;
}

function updateQuarters(){
const quarters=[
...new Set(
rows
.filter(row=>row.cohort_state===cohort.value)
.map(row=>row.yr_qtr)
)
].sort(naturalSort);

const previous=quarter.value;

quarter.innerHTML=quarters.map(
value=>`<option value="${value}">${value}</option>`
).join("");

if(quarters.includes(previous)){
quarter.value=previous;
}
}

function summarize(selectedRows,groupField,metricName){
const groups=new Map();

selectedRows.forEach(row=>{
const name=String(row[groupField]);
const count=Number(row.count)||0;
const metricValue=Number(row[metricName]);

if(!groups.has(name)){
groups.set(name,{
name:name,
count:0,
weightedTotal:0,
weight:0
});
}

const group=groups.get(name);
group.count+=count;

if(Number.isFinite(metricValue)){
if(count>0){
group.weightedTotal+=metricValue*count;
group.weight+=count;
}else{
group.weightedTotal+=metricValue;
group.weight+=1;
}
}
});

return [...groups.values()]
.map(group=>({
name:group.name,
value:metricName==="count"
?group.count
:group.weight>0
?group.weightedTotal/group.weight
:0
}))
.filter(group=>group.value>0)
.sort((a,b)=>b.value-a.value);
}

function draw(){
const metricName=metric.value;
const groupField=dimension.value;

const selectedRows=rows.filter(
row=>
row.cohort_state===cohort.value &&
row.yr_qtr===quarter.value
);

const groups=summarize(
selectedRows,
groupField,
metricName
);

const rootLabel=`${cohort.value} cohort`;
const labels=[
rootLabel,
...groups.map(group=>group.name)
];

const source=groups.map(()=>0);
const target=groups.map(
(group,index)=>index+1
);
const values=groups.map(
group=>group.value
);

const nodeColors=[
"#263b80",
...groups.map(
group=>colorFor(group.name)
)
];

const linkColors=groups.map(
group=>colorFor(group.name,.35)
);

const currency=metricName!=="count";
const metricLabel=
metric.options[metric.selectedIndex].text;
const dimensionLabel=
dimension.options[dimension.selectedIndex].text;

const trace={
type:"sankey",
orientation:"h",
arrangement:"snap",
valueformat:currency?",.2f":",.0f",
valuesuffix:currency?"":" workers",
node:{
pad:18,
thickness:20,
line:{
color:"#555",
width:.4
},
label:labels,
color:nodeColors,
hovertemplate:"%{label}<extra></extra>"
},
link:{
source:source,
target:target,
value:values,
color:linkColors,
customdata:groups.map(
group=>group.name
),
hovertemplate:
"Cohort: "+cohort.value+
"<br>"+dimensionLabel+": %{customdata}"+
"<br>"+metricLabel+": "+
(currency?"$":"")+
"%{value:,.2f}<extra></extra>"
}
};

const layout={
title:{
text:
`Cohort ${cohort.value} → ${dimensionLabel}<br>`+
`<sup>${quarter.value} | ${metricLabel}</sup>`,
x:.5
},
font:{
size:13
},
paper_bgcolor:"#f7f8fa",
plot_bgcolor:"#f7f8fa",
margin:{
l:40,
r:40,
t:80,
b:30
}
};

Plotly.react(
"chart",
[trace],
layout,
{
responsive:true,
displaylogo:false
}
);
}

cohort.addEventListener(
"change",
()=>{
updateQuarters();
draw();
}
);

quarter.addEventListener("change",draw);
dimension.addEventListener("change",draw);
metric.addEventListener("change",draw);

updateQuarters();
draw();
</script>
</body>
</html>"""

    html=html.replace(
        "__PLOTLY__",
        get_plotlyjs()
    ).replace(
        "__DATA__",
        app_data
    ).replace(
        "__COHORTS__",
        cohorts
    )

    output_path=Path(output_html).resolve()
    output_path.write_text(
        html,
        encoding="utf-8"
    )

    print(f"Created: {output_path}")
    return output_path

create_state_sector_sankey(
    xlsx_path="state_flows.xlsx",
    output_html="state_sector_sankey.html",
    tabs=["WI","IL","IA","MN","IN"]
)
