import pandas as pd
from statistical_disclosure_control import SuppressionConfig,protect_table,verify_protection

df=pd.read_excel("input.xlsx")

config=SuppressionConfig(
    minimum_count=10,
    wage_round_base=10,
    protect_all_margin_levels=True
)

result=protect_table(df,config)

protected_df=result.protected
audit_df=result.audit
summary_df=result.summary

verification_df=verify_protection(protected_df,config)

protected_df.to_excel("protected_output.xlsx",index=False)
audit_df.to_excel("suppression_audit.xlsx",index=False)
summary_df.to_excel("suppression_summary.xlsx",index=False)
verification_df.to_excel("suppression_verification.xlsx",index=False)

print(summary_df.to_string(index=False))
print("All margins safe:",verification_df["safe"].all())
