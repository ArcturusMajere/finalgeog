import pyarrow.csv as pcsv

def parquet_to_csv(source_dir, target_dir, source_ssh=None, target_ssh=None,
                   batch_size=65536, overwrite=False):
    if batch_size < 1:
        raise ValueError("batch_size must be positive")
    with ExitStack() as stack:
        def open_directory(directory, connection, create=False):
            if connection is None:
                return stack.enter_context(
                    OSFS(str(Path(directory).expanduser()), create=create))
            directory = str(directory)
            if not directory.startswith("/"):
                raise ValueError("Use absolute paths for remote directories")
            options = {"timeout":30, "policy":RejectPolicy()}
            options.update(connection)
            root = stack.enter_context(SSHFS(**options))
            if create:
                stack.enter_context(root.makedirs(directory, recreate=True))
            return stack.enter_context(root.opendir(directory))
        source = open_directory(source_dir, source_ssh)
        target = open_directory(target_dir, target_ssh, create=True)
        names = sorted(f.name for f in source.scandir("/")
                       if f.is_file and f.name.lower().endswith(".parquet"))
        read_options = {"prefetch":False} if source_ssh is not None else {}
        write_options = {"pipelined":True} if target_ssh is not None else {}
        results = []
        for name in names:
            csv_name = name[:-8] + ".csv"
            if target.exists(csv_name) and not overwrite:
                raise FileExistsError(csv_name)
            temporary = f".{csv_name}.{uuid4().hex}.part"
            rows = 0
            try:
                with ExitStack() as files:
                    reader = files.enter_context(
                        source.openbin(name, "r", **read_options))
                    output = files.enter_context(
                        target.openbin(temporary, "w", **write_options))
                    parquet = files.enter_context(pq.ParquetFile(reader))
                    writer = files.enter_context(pcsv.CSVWriter(
                        output, parquet.schema_arrow,
                        write_options=pcsv.WriteOptions(include_header=True)))
                    for batch in parquet.iter_batches(batch_size=batch_size):
                        writer.write_batch(batch)
                        rows += batch.num_rows
                target.move(temporary, csv_name, overwrite=overwrite)
            finally:
                with suppress(ResourceNotFound):
                    target.remove(temporary)
            results.append({"parquet":name, "csv":csv_name, "rows":rows})
            print(f"{name} -> {csv_name} | {rows:,} rows")
        return results

