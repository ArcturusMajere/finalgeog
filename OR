import json
import pandas as pd
import plotly.io as pio

def create_cohort_flow_app(
    xlsx_file,
    output_html="cohort_flows.html",
    tabs=None,
    cohort_yr_qtr="2022-1",
    top_n=15
):
    required={"yr_qtr","state","sector","count"}
    sheets=pd.read_excel(xlsx_file,sheet_name=tabs if tabs else None)

    if isinstance(sheets,pd.DataFrame):
        tab_name=tabs if isinstance(tabs,str) else "Cohort"
        sheets={tab_name:sheets}

    frames=[]

    for tab,df in sheets.items():
        df.columns=df.columns.astype(str).str.strip().str.lower()
        missing=required-set(df.columns)

        if missing:
            raise ValueError(
                f"Tab '{tab}' is missing columns: {sorted(missing)}"
            )

        part=df[["yr_qtr","state","sector","count"]].copy()
        part["cohort_state"]=str(tab).strip().upper()
        part["yr_qtr"]=part["yr_qtr"].astype(str).str.strip()
        part["state"]=part["state"].astype(str).str.strip().str.upper()
        part["sector"]=part["sector"].astype(str).str.strip()
        part["count"]=pd.to_numeric(part["count"],errors="coerce")

        part=part.dropna(
            subset=["yr_qtr","state","sector","count"]
        )

        part=part[
            (part["state"]!="") &
            (part["sector"]!="") &
            (part["count"]>0)
        ]

        frames.append(part)

    if not frames:
        raise ValueError("No valid workbook tabs were found.")

    data=pd.concat(frames,ignore_index=True)

    data=(
        data.groupby(
            ["cohort_state","yr_qtr","state","sector"],
            as_index=False
        )["count"].sum()
    )

    def quarter_sort_key(value):
        text=str(value).strip().upper().replace("Q","-")
        parts=[part for part in text.split("-") if part]

        try:
            return int(parts[0])*4+int(parts[1])-1
        except (ValueError,IndexError):
            return float("inf")

    cohorts=sorted(data["cohort_state"].unique())
    quarters=sorted(
        data["yr_qtr"].unique(),
        key=quarter_sort_key
    )

    records=data.to_dict("records")
    records_json=json.dumps(records).replace("</","<\\/")
    cohorts_json=json.dumps(cohorts)
    quarters_json=json.dumps(quarters)
    cohort_period_json=json.dumps(str(cohort_yr_qtr))
    plotly_js=pio.get_plotlyjs()

    html=f"""<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Cohort Flow Analysis</title>
<style>
body{{
font-family:Arial,sans-serif;
margin:20px;
background:#f4f6f8;
color:#222
}}
.controls{{
display:flex;
flex-wrap:wrap;
gap:18px;
padding:16px;
background:white;
border-radius:8px;
box-shadow:0 2px 8px #00000018
}}
label{{
display:block;
font-weight:bold;
margin-bottom:6px
}}
select{{
min-width:180px;
padding:8px;
border:1px solid #aaa;
border-radius:5px
}}
.summary{{
margin-top:16px;
padding:14px 16px;
background:white;
border-radius:8px;
font-weight:bold
}}
#sankey,#bars{{
margin-top:16px;
background:white;
border-radius:8px
}}
@media(max-width:700px){{
.controls{{
display:block
}}
.controls div{{
margin-bottom:12px
}}
select{{
width:100%
}}
}}
</style>
<script>{plotly_js}</script>
</head>
<body>
<div class="controls">
<div>
<label for="cohort">2022-1 cohort state</label>
<select id="cohort"></select>
</div>
<div>
<label for="quarter">Destination quarter</label>
<select id="quarter"></select>
</div>
<div>
<label for="flowType">Flow type</label>
<select id="flowType">
<option value="state">State flows</option>
<option value="sector">Sector flows</option>
</select>
</div>
</div>

<div id="summary" class="summary"></div>
<div id="sankey"></div>
<div id="bars"></div>

<script>
const records={records_json};
const cohorts={cohorts_json};
const quarters={quarters_json};
const cohortPeriod={cohort_period_json};
const topN={int(top_n)};

const cohortSelect=document.getElementById("cohort");
const quarterSelect=document.getElementById("quarter");
const flowTypeSelect=document.getElementById("flowType");
const summary=document.getElementById("summary");

cohorts.forEach(value=>{{
cohortSelect.add(new Option(value,value));
}});

quarters.forEach(value=>{{
quarterSelect.add(new Option(value,value));
}});

if(quarters.includes(cohortPeriod)){{
quarterSelect.value=cohortPeriod;
}}

function groupSum(rows,field){{
const grouped={{}};

rows.forEach(row=>{{
const value=String(row[field]);
grouped[value]=(grouped[value]||0)+Number(row.count);
}});

return Object.entries(grouped)
.sort((a,b)=>b[1]-a[1]);
}}

function updateApp(){{
const cohort=cohortSelect.value;
const quarter=quarterSelect.value;
const flowType=flowTypeSelect.value;
const destinationLabel=flowType==="state"?"State":"Sector";

const filtered=records.filter(row=>
row.cohort_state===cohort &&
row.yr_qtr===quarter
);

const allTotals=groupSum(filtered,flowType);
const totals=allTotals.slice(0,topN);
const origin=cohort+" cohort ("+cohortPeriod+")";
const destinations=totals.map(item=>item[0]);
const values=totals.map(item=>item[1]);
const labels=[origin,...destinations];
const sources=destinations.map(()=>0);
const targets=destinations.map((value,index)=>index+1);
const displayedTotal=values.reduce((sum,value)=>sum+value,0);
const fullTotal=allTotals.reduce(
(sum,item)=>sum+item[1],0
);

summary.textContent=
cohort+" cohort formed in "+cohortPeriod+
" | Destination quarter: "+quarter+
" | Total "+destinationLabel.toLowerCase()+
" flow count: "+fullTotal.toLocaleString();

if(!totals.length){{
Plotly.react("sankey",[],{{
title:"No data for the selected cohort and quarter",
height:300
}});

Plotly.react("bars",[],{{
title:"No data for the selected cohort and quarter",
height:300
}});

return;
}}

Plotly.react("sankey",[{
type:"sankey",
orientation:"h",
node:{{
label:labels,
pad:18,
thickness:20,
line:{{
color:"#555",
width:0.5
}},
color:labels.map((value,index)=>
index===0
?"#d62728"
:flowType==="state"
?"#1f77b4"
:"#2ca02c"
)
}},
link:{{
source:sources,
target:targets,
value:values,
customdata:destinations,
color:destinations.map(()=>
flowType==="state"
?"rgba(31,119,180,0.45)"
:"rgba(44,160,44,0.45)"
),
hovertemplate:
destinationLabel+": %{{customdata}}<br>"+
"Count: %{{value:,.0f}}<extra></extra>"
}}
}}],{{
title:
"Largest "+destinationLabel.toLowerCase()+
" flows from the "+cohort+" cohort",
height:600,
font:{{
size:12
}},
margin:{{
l:30,
r:30,
t:70,
b:30
}},
annotations:[{{
text:
"Top "+totals.length+
" shown | Displayed count: "+
displayedTotal.toLocaleString(),
xref:"paper",
yref:"paper",
x:0,
y:-0.08,
showarrow:false,
xanchor:"left"
}}]
}},{{responsive:true}});

const reversed=[...totals].reverse();

Plotly.react("bars",[{
type:"bar",
orientation:"h",
x:reversed.map(item=>item[1]),
y:reversed.map(item=>item[0]),
text:reversed.map(item=>item[1].toLocaleString()),
textposition:"outside",
cliponaxis:false,
marker:{{
color:flowType==="state"
?"#1f77b4"
:"#2ca02c"
}},
hovertemplate:
destinationLabel+": %{{y}}<br>"+
"Count: %{{x:,.0f}}<extra></extra>"
}}],{{
title:
"Largest "+destinationLabel.toLowerCase()+
" flows",
xaxis:{{
title:"Count",
rangemode:"tozero"
}},
yaxis:{{
title:destinationLabel,
automargin:true
}},
height:Math.max(450,totals.length*32),
margin:{{
l:140,
r:80,
t:60,
b:60
}}
}},{{responsive:true}});
}}

cohortSelect.addEventListener("change",updateApp);
quarterSelect.addEventListener("change",updateApp);
flowTypeSelect.addEventListener("change",updateApp);

updateApp();
</script>
</body>
</html>"""

    with open(output_html,"w",encoding="utf-8") as file:
        file.write(html)

    print(f"Saved: {output_html}")
    return output_html

create_cohort_flow_app(
    xlsx_file="cohort_data.xlsx",
    output_html="cohort_flows.html",
    tabs=["WI","IL","IA","MN","IN"],
    cohort_yr_qtr="2022-1",
    top_n=15
)
