import pandas as pd

def suppress_large_df(
    df,
    threshold=10,
    quarter_col="yr_qtr",
    state_col="state",
    sector_col="sector",
    count_col="count",
    value_cols=("mean","med","25","75"),
    rounding=None
):
    group_cols=[
        quarter_col,
        state_col,
        sector_col
    ]

    protected_cols=[
        count_col,
        *value_cols
    ]

    required=group_cols+protected_cols

    missing=[
        column for column in required
        if column not in df.columns
    ]

    if missing:
        raise ValueError(
            f"Missing columns: {missing}"
        )

    duplicate_mask=df.duplicated(
        group_cols,
        keep=False
    )

    if duplicate_mask.any():
        examples=(
            df.loc[
                duplicate_mask,
                group_cols
            ]
            .head(10)
            .to_dict("records")
        )

        raise ValueError(
            "Duplicate quarter-state-sector cells found. "
            f"Aggregate them first. Examples: {examples}"
        )

    protected=df.copy().reset_index(drop=True)

    for column in protected_cols:
        protected[column]=pd.to_numeric(
            protected[column],
            errors="coerce"
        ).astype("Float64")

    protected["suppressed"]=False
    protected["suppression_type"]="published"
    protected["suppression_round"]=pd.Series(
        0,
        index=protected.index,
        dtype="Int64"
    )

    primary_mask=(
        protected[count_col].notna()
        &protected[count_col].gt(0)
        &protected[count_col].lt(threshold)
    )

    protected.loc[
        primary_mask,
        "suppressed"
    ]=True

    protected.loc[
        primary_mask,
        "suppression_type"
    ]="primary"

    protected.loc[
        primary_mask,
        "suppression_round"
    ]=1

    def select_smallest(indexes):
        candidates=[
            index
            for index in indexes
            if not protected.at[index,"suppressed"]
            and pd.notna(
                protected.at[index,count_col]
            )
        ]

        if not candidates:
            return None

        return min(
            candidates,
            key=lambda index:(
                protected.at[index,count_col],
                index
            )
        )

    quarter_groups=protected.groupby(
        quarter_col,
        dropna=False,
        sort=False
    )

    for _,quarter_df in quarter_groups:
        quarter_indexes=quarter_df.index.tolist()
        iteration=1

        while True:
            additions=set()

            state_groups=(
                protected.loc[quarter_indexes]
                .groupby(
                    state_col,
                    dropna=False,
                    sort=False
                )
                .groups
            )

            for indexes in state_groups.values():
                indexes=list(indexes)

                suppression_count=sum(
                    protected.at[index,"suppressed"]
                    for index in indexes
                )

                if suppression_count==1:
                    selected=select_smallest(indexes)

                    if selected is not None:
                        additions.add(selected)

            sector_groups=(
                protected.loc[quarter_indexes]
                .groupby(
                    sector_col,
                    dropna=False,
                    sort=False
                )
                .groups
            )

            for indexes in sector_groups.values():
                indexes=list(indexes)

                suppression_count=sum(
                    protected.at[index,"suppressed"]
                    for index in indexes
                )

                if suppression_count==1:
                    selected=select_smallest(indexes)

                    if selected is not None:
                        additions.add(selected)

            if not additions:
                break

            suppression_type=(
                "secondary"
                if iteration==1
                else "tertiary"
            )

            for index in additions:
                if protected.at[index,"suppressed"]:
                    continue

                protected.at[
                    index,
                    "suppressed"
                ]=True

                protected.at[
                    index,
                    "suppression_type"
                ]=suppression_type

                protected.at[
                    index,
                    "suppression_round"
                ]=iteration+1

            iteration+=1

            if iteration>len(quarter_indexes)+1:
                raise RuntimeError(
                    f"Suppression did not converge for quarter {_}"
                )

    original_counts=protected[count_col].copy()

    margin_source=protected.assign(
        _original_count=original_counts
    )

    state_counts=(
        margin_source
        .groupby(
            [quarter_col,state_col],
            dropna=False
        )["_original_count"]
        .sum(min_count=1)
        .rename("count")
        .reset_index()
    )

    state_flags=(
        protected
        .groupby(
            [quarter_col,state_col],
            dropna=False
        )["suppressed"]
        .any()
        .reset_index()
    )

    state_margins=state_counts.merge(
        state_flags,
        on=[quarter_col,state_col],
       ],
        how="left"
    )

    state_margins["margin_type"]="state"
    state_margins["margin_value"]=(
        state_margins[state_col].astype(str)
    )

    sector_counts=(
        margin_source
        .groupby(
            [quarter_col,sector_col],
            dropna=False
        )["_original_count"]
        .sum(min_count=1)
        .rename("count")
        .reset_index()
    )

    sector_flags=(
        protected
        .groupby(
            [quarter_col,sector_col],
            dropna=False
        )["suppressed"]
        .any()
        .reset_index()
    )

    sector_margins=sector_counts.merge(
        sector_flags,
        on=[quarter_col,sector_col],
        how="left"
    )

    sector_margins["margin_type"]="sector"
    sector_margins["margin_value"]=(
        sector_margins[sector_col].astype(str)
    )

    grand_counts=(
        margin_source
        .groupby(
            quarter_col,
            dropna=False
        )["_original_count"]
        .sum(min_count=1)
        .rename("count")
        .reset_index()
    )

    grand_flags=(
        protected
        .groupby(
            quarter_col,
            dropna=False
        )["suppressed"]
        .any()
        .reset_index()
    )

    grand_margins=grand_counts.merge(
        grand_flags,
        on=quarter_col,
        how="left"
    )

    grand_margins["margin_type"]="grand_total"
    grand_margins["margin_value"]="Total"

    margin_cols=[
        quarter_col,
        "margin_type",
        "margin_value",
        "count",
        "suppressed"
    ]

    margins=pd.concat(
        [
            state_margins[margin_cols],
            sector_margins[margin_cols],
            grand_margins[margin_cols]
        ],
        ignore_index=True
    )

    margins["count"]=margins["count"].astype("Float64")

    margins.loc[
        margins["suppressed"],
        "count"
    ]=pd.NA

    protected.loc[
        protected["suppressed"],
        protected_cols
    ]=pd.NA

    if rounding is not None:
        if isinstance(rounding,(int,float)):
            rounding={
                column:rounding
                for column in protected_cols
            }

        if not isinstance(rounding,dict):
            raise ValueError(
                "rounding must be a number, dictionary or None"
            )

        published_mask=~protected["suppressed"]

        for column,base in rounding.items():
            if column not in protected_cols:
                continue

            if base<=0:
                raise ValueError(
                    f"Rounding base for {column} must be positive"
                )

            protected.loc[
                published_mask,
                column
            ]=(
                protected.loc[
                    published_mask,
                    column
                ]/base
            ).round()*base

        if count_col in rounding:
            base=rounding[count_col]
            visible_margin=~margins["suppressed"]

            margins.loc[
                visible_margin,
                "count"
            ]=(
                margins.loc[
                    visible_margin,
                    "count"
                ]/base
            ).round()*base

    audit=(
        protected["suppression_type"]
        .value_counts()
        .rename_axis("suppression_type")
        .reset_index(name="cell_count")
    )

    return protected,margins,audit




protected_df,margins_df,audit_df=suppress_large_df(
    df,
    threshold=10,
    value_cols=("mean","med","25","75"),
    rounding={
        "mean":10,
        "med":10,
        "25":10,
        "75":10
    }
)
