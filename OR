from __future__ import annotations

from dataclasses import dataclass
from itertools import combinations
from typing import Callable, Iterable, Sequence

import numpy as np
import pandas as pd
from scipy.optimize import Bounds, LinearConstraint, milp
from scipy.sparse import lil_matrix


@dataclass(frozen=True)
class SuppressionConfig:
    dimensions: tuple[str, ...] = ("yr_qtr", "state", "sector")
    count_col: str = "count"
    protected_cols: tuple[str, ...] = (
        "count",
        "mean_wage",
        "median_wage",
        "percentile_25",
        "percentile_75",
    )
    minimum_count: int = 10
    wage_round_base: int = 10
    suppression_value: str = "--"
    suppress_zero_counts: bool = False
    protect_all_margin_levels: bool = True
    margin_groupings: tuple[tuple[str, ...], ...] | None = None
    suppression_cost: str | Callable[[pd.DataFrame], Iterable[float]] = "count"
    solver_time_limit: float | None = 120.0
    relative_mip_gap: float = 0.0
    add_flag_columns: bool = True


@dataclass(frozen=True)
class SuppressionResult:
    protected: pd.DataFrame
    audit: pd.DataFrame
    summary: pd.DataFrame
    solver_message: str


def protect_table(
    df: pd.DataFrame,
    config: SuppressionConfig | None = None,
    additional_primary: pd.Series | Sequence[bool] | Callable[[pd.DataFrame], Iterable[bool]] | None = None,
) -> SuppressionResult:
    cfg = config or SuppressionConfig()
    if "_source_index" in df.columns:
        raise ValueError("Input cannot contain the reserved column _source_index")
    work = df.copy(deep=True).reset_index(drop=True)
    work.insert(0, "_source_index", np.arange(len(work)))
    _validate(work, cfg)
    n = len(work)
    if n == 0:
        empty_audit = pd.DataFrame(columns=["_source_index", *cfg.dimensions, "suppression_status", "suppression_reason"])
        summary = pd.DataFrame([{"input_cells": 0, "released_cells": 0, "primary_cells": 0, "complementary_cells": 0, "suppressed_cells": 0}])
        return SuppressionResult(df.copy(), empty_audit, summary, "No cells to optimize")
    count = pd.to_numeric(work[cfg.count_col], errors="raise").to_numpy(dtype=float)
    primary = count < cfg.minimum_count
    if not cfg.suppress_zero_counts:
        primary &= count > 0
    primary |= _primary_mask(work, additional_primary)
    groupings = _resolve_groupings(cfg)
    groups, group_labels = _build_groups(work, groupings)
    _check_protectability(primary, groups, group_labels)
    costs = _suppression_costs(work, cfg, primary)
    selected, solver_message = _solve_suppression(primary, groups, costs, cfg)
    status = np.full(n, "released", dtype=object)
    status[selected & ~primary] = "complementary"
    status[primary] = "primary"
    protected = work.copy()
    wage_cols = [c for c in cfg.protected_cols if c != cfg.count_col]
    for col in wage_cols:
        protected[col] = _round_to_base(protected[col], cfg.wage_round_base)
    protected[list(cfg.protected_cols)] = protected[list(cfg.protected_cols)].astype(object)
    protected.loc[selected, list(cfg.protected_cols)] = cfg.suppression_value
    if cfg.add_flag_columns:
        protected["is_suppressed"] = selected
        protected["suppression_status"] = status
    audit = _make_audit(work, protected, cfg, primary, selected, status, groups, group_labels)
    summary = _make_summary(n, primary, selected, cfg, groupings, solver_message)
    protected = protected.sort_values("_source_index").drop(columns="_source_index").reset_index(drop=True)
    return SuppressionResult(protected, audit, summary, solver_message)


def _validate(df: pd.DataFrame, cfg: SuppressionConfig) -> None:
    required = set(cfg.dimensions) | {cfg.count_col} | set(cfg.protected_cols)
    missing = sorted(required - set(df.columns))
    if missing:
        raise ValueError(f"Missing required columns: {missing}")
    if cfg.count_col not in cfg.protected_cols:
        raise ValueError("count_col must be included in protected_cols")
    if len(cfg.dimensions) < 2:
        raise ValueError("At least two dimensions are required")
    if cfg.minimum_count < 1:
        raise ValueError("minimum_count must be at least 1")
    if cfg.wage_round_base < 1:
        raise ValueError("wage_round_base must be at least 1")
    if df[list(cfg.dimensions)].isna().any().any():
        raise ValueError("Dimension columns cannot contain missing values")
    duplicated = df.duplicated(list(cfg.dimensions), keep=False)
    if duplicated.any():
        sample = df.loc[duplicated, list(cfg.dimensions)].head(5).to_dict("records")
        raise ValueError(f"Each dimension combination must be unique; duplicates include {sample}")
    count = pd.to_numeric(df[cfg.count_col], errors="raise")
    if count.isna().any() or (~np.isfinite(count)).any() or (count < 0).any():
        raise ValueError("count must contain finite, nonnegative values")
    if not np.allclose(count, np.round(count)):
        raise ValueError("count must contain whole numbers")


def _primary_mask(df: pd.DataFrame, rule) -> np.ndarray:
    if rule is None:
        return np.zeros(len(df), dtype=bool)
    values = rule(df.copy()) if callable(rule) else rule
    mask = pd.Series(values, index=df.index)
    if len(mask) != len(df) or mask.isna().any():
        raise ValueError("additional_primary must provide one nonmissing boolean per row")
    return mask.astype(bool).to_numpy()


def _resolve_groupings(cfg: SuppressionConfig) -> tuple[tuple[str, ...], ...]:
    dims = cfg.dimensions
    if cfg.margin_groupings is not None:
        groupings = tuple(tuple(g) for g in cfg.margin_groupings)
    elif cfg.protect_all_margin_levels:
        groupings = tuple(g for size in range(1, len(dims)) for g in combinations(dims, size))
    else:
        groupings = tuple(combinations(dims, len(dims) - 1))
    invalid = [g for g in groupings if not g or not set(g).issubset(dims) or len(set(g)) != len(g)]
    if invalid:
        raise ValueError(f"Invalid margin_groupings: {invalid}")
    return tuple(dict.fromkeys(groupings))


def _build_groups(df: pd.DataFrame, groupings: Sequence[Sequence[str]]):
    groups = []
    labels = []
    for grouping in groupings:
        grouper = grouping[0] if len(grouping) == 1 else list(grouping)
        for key, positions in df.groupby(grouper, sort=False, dropna=False).indices.items():
            idx = np.asarray(positions, dtype=int)
            if len(idx) > 1:
                groups.append(idx)
                values = key if isinstance(key, tuple) else (key,)
                labels.append("|".join(f"{col}={value}" for col, value in zip(grouping, values)))
    return groups, labels


def _check_protectability(primary: np.ndarray, groups, labels) -> None:
    covered = np.zeros(len(primary), dtype=bool)
    for group in groups:
        covered[group] = True
    uncovered = np.flatnonzero(primary & ~covered)
    if len(uncovered):
        raise ValueError(f"Primary cells {uncovered.tolist()} are not protected by any multi-cell margin")


def _suppression_costs(df: pd.DataFrame, cfg: SuppressionConfig, primary: np.ndarray) -> np.ndarray:
    if callable(cfg.suppression_cost):
        cost = np.asarray(list(cfg.suppression_cost(df.copy())), dtype=float)
    elif cfg.suppression_cost == "count":
        cost = pd.to_numeric(df[cfg.count_col], errors="raise").to_numpy(dtype=float) + 1.0
    elif cfg.suppression_cost == "uniform":
        cost = np.ones(len(df), dtype=float)
    else:
        if cfg.suppression_cost not in df.columns:
            raise ValueError("suppression_cost must be 'count', 'uniform', a column, or a callable")
        cost = pd.to_numeric(df[cfg.suppression_cost], errors="raise").to_numpy(dtype=float)
    if len(cost) != len(df) or np.any(~np.isfinite(cost)) or np.any(cost < 0):
        raise ValueError("Suppression costs must be finite, nonnegative, and match the row count")
    cost = cost.copy()
    cost[primary] = 0.0
    return cost


def _solve_suppression(primary, groups, costs, cfg):
    n = len(primary)
    g = len(groups)
    variables = n + g
    objective = np.concatenate([costs, np.zeros(g)])
    matrix = lil_matrix((2 * g, variables), dtype=float)
    lower = np.full(2 * g, -np.inf)
    upper = np.full(2 * g, np.inf)
    for j, group in enumerate(groups):
        matrix[2 * j, group] = 1.0
        matrix[2 * j, n + j] = -2.0
        lower[2 * j] = 0.0
        matrix[2 * j + 1, group] = 1.0
        matrix[2 * j + 1, n + j] = -float(len(group))
        upper[2 * j + 1] = 0.0
    lower_bounds = np.zeros(variables)
    upper_bounds = np.ones(variables)
    lower_bounds[:n][primary] = 1.0
    upper_bounds[:n][primary] = 1.0
    options = {"mip_rel_gap": cfg.relative_mip_gap, "disp": False}
    if cfg.solver_time_limit is not None:
        options["time_limit"] = cfg.solver_time_limit
    result = milp(
        c=objective,
        integrality=np.ones(variables),
        bounds=Bounds(lower_bounds, upper_bounds),
        constraints=LinearConstraint(matrix.tocsr(), lower, upper),
        options=options,
    )
    if result.x is None:
        raise RuntimeError(f"Suppression optimization failed: {result.message}")
    selected = result.x[:n] >= 0.5
    _verify_solution(selected, primary, groups)
    return selected, str(result.message)


def _verify_solution(selected, primary, groups) -> None:
    if not np.all(selected[primary]):
        raise RuntimeError("Solver returned a solution that releases a primary cell")
    unsafe = [i for i, group in enumerate(groups) if selected[group].sum() == 1]
    if unsafe:
        raise RuntimeError(f"Solver returned {len(unsafe)} margins with exactly one suppressed cell")


def _round_to_base(series: pd.Series, base: int) -> pd.Series:
    numeric = pd.to_numeric(series, errors="coerce")
    rounded = np.sign(numeric) * np.floor(np.abs(numeric) / base + 0.5) * base
    return rounded.where(series.notna())


def _make_audit(original, protected, cfg, primary, selected, status, groups, labels):
    memberships = [[] for _ in range(len(original))]
    for group, label in zip(groups, labels):
        if selected[group].sum() > 0:
            for row in group:
                memberships[row].append(label)
    audit = original[["_source_index", *cfg.dimensions]].copy()
    audit["suppression_status"] = status
    audit["suppression_reason"] = np.where(primary, f"count below {cfg.minimum_count} or additional rule", np.where(selected, "complementary margin protection", "released"))
    audit["protected_margin_count"] = [len(x) if selected[i] else 0 for i, x in enumerate(memberships)]
    audit["protected_margins"] = ["; ".join(x) if selected[i] else "" for i, x in enumerate(memberships)]
    for col in cfg.protected_cols:
        audit[f"original_{col}"] = original[col]
        audit[f"released_{col}"] = protected[col]
    return audit.sort_values("_source_index").reset_index(drop=True)


def _make_summary(n, primary, selected, cfg, groupings, solver_message):
    return pd.DataFrame([{
        "input_cells": n,
        "released_cells": int((~selected).sum()),
        "primary_cells": int(primary.sum()),
        "complementary_cells": int((selected & ~primary).sum()),
        "suppressed_cells": int(selected.sum()),
        "suppression_rate": float(selected.mean()),
        "minimum_count": cfg.minimum_count,
        "wage_round_base": cfg.wage_round_base,
        "suppression_value": cfg.suppression_value,
        "protected_margin_groupings": "; ".join(",".join(g) for g in groupings),
        "solver_message": solver_message,
    }])


def verify_protection(
    protected_df: pd.DataFrame,
    config: SuppressionConfig | None = None,
) -> pd.DataFrame:
    cfg = config or SuppressionConfig()
    validation_df = protected_df.copy()
    validation_df[cfg.count_col] = 0
    _validate(validation_df, cfg)
    if "is_suppressed" in protected_df.columns:
        selected = protected_df["is_suppressed"].astype(bool).to_numpy()
    else:
        selected = protected_df[cfg.count_col].eq(cfg.suppression_value).to_numpy()
    groupings = _resolve_groupings(cfg)
    groups, labels = _build_groups(protected_df.reset_index(drop=True), groupings)
    rows = []
    for group, label in zip(groups, labels):
        suppressed = int(selected[group].sum())
        rows.append({"margin": label, "cell_count": len(group), "suppressed_count": suppressed, "safe": suppressed != 1})
    return pd.DataFrame(rows)
