#Use 2Glue Spark jobs. Run the first job once for each year-quarter partition, then run the second job once across the reduced results.
#job1

SOURCE_ROOT="s3://your-data-bucket/parquet"
INTERMEDIATE_ROOT="s3://your-output-bucket/quarterly-unique-ids"
YEAR=2024
QUARTER=1
SHUFFLE_PARTITIONS=4000

input_path=f"{SOURCE_ROOT}/yr={YEAR}/qtr={QUARTER}/"
output_path=f"{INTERMEDIATE_ROOT}/yr={YEAR}/qtr={QUARTER}/"

sc=SparkContext.getOrCreate()
glue_context=GlueContext(sc)
spark=glue_context.spark_session

spark.conf.set("spark.sql.adaptive.enabled","true")
spark.conf.set("spark.sql.adaptive.coalescePartitions.enabled","true")
spark.conf.set("spark.sql.adaptive.skewJoin.enabled","true")
spark.conf.set("spark.sql.shuffle.partitions",str(SHUFFLE_PARTITIONS))
spark.conf.set("spark.sql.files.maxPartitionBytes","134217728")
spark.conf.set("spark.sql.parquet.compression.codec","snappy")

job=Job(glue_context)
job.init(f"quarterly_unique_ids_{YEAR}_{QUARTER}",{})

quarter_ids=(
    spark.read
    .parquet(input_path)
    .select(F.trim(F.col("ID")).alias("ID"))
    .filter(
        F.col("ID").isNotNull()&
        (F.col("ID")!="")
    )
    .dropDuplicates(["ID"])
    .withColumn("quarter_index",F.lit(YEAR*4+QUARTER-1))
)

(
    quarter_ids.write
    .mode("overwrite")
    .option("compression","snappy")
    .option("maxRecordsPerFile",5000000)
    .parquet(output_path)
)

job.commit()




#job2

from awsglue.context import GlueContext
from awsglue.job import Job
from pyspark.context import SparkContext
from pyspark.sql import functions as F

INTERMEDIATE_ROOT="s3://your-output-bucket/quarterly-unique-ids/"
FINAL_OUTPUT="s3://your-output-bucket/id-first-occurrence/"
SHUFFLE_PARTITIONS=8000

sc=SparkContext.getOrCreate()
glue_context=GlueContext(sc)
spark=glue_context.spark_session

spark.conf.set("spark.sql.adaptive.enabled","true")
spark.conf.set("spark.sql.adaptive.coalescePartitions.enabled","true")
spark.conf.set("spark.sql.adaptive.skewJoin.enabled","true")
spark.conf.set("spark.sql.shuffle.partitions",str(SHUFFLE_PARTITIONS))
spark.conf.set("spark.sql.files.maxPartitionBytes","134217728")
spark.conf.set("spark.sql.parquet.compression.codec","snappy")

job=Job(glue_context)
job.init("final_id_first_occurrence",{})

first_occurrence=(
    spark.read
    .parquet(INTERMEDIATE_ROOT)
    .select("ID","quarter_index")
    .groupBy("ID")
    .agg(F.min("quarter_index").alias("first_quarter_index"))
    .select(
        "ID",
        F.floor(F.col("first_quarter_index")/4)
        .cast("int")
        .alias("first_yr"),
        (F.col("first_quarter_index")%4+1)
        .cast("int")
        .alias("first_qtr")
    )
    .withColumn(
        "first_yr_qtr",
        F.concat(
            F.col("first_yr").cast("string"),
            F.lit("-Q"),
            F.col("first_qtr").cast("string")
        )
    )
)

(
    first_occurrence.write
    .mode("overwrite")
    .option("compression","snappy")
    .option("maxRecordsPerFile",5000000)
    .partitionBy("first_yr")
    .parquet(FINAL_OUTPUT)
)

job.commit()
