from pathlib import Path
import json
import pandas as pd

def create_top5_dashboard(
    xlsx_path,
    output_html="top5_dashboard.html",
    tabs=None
):
    metrics=[
        "count",
        "mean_wage",
        "median_wage",
        "percentile_25",
        "percentile_75"
    ]
    required=["yr_qtr","state","sector"]+metrics
    workbook=pd.ExcelFile(xlsx_path)
    selected_tabs=workbook.sheet_names if tabs is None else list(tabs)

    missing_tabs=[
        tab for tab in selected_tabs
        if tab not in workbook.sheet_names
    ]

    if missing_tabs:
        raise ValueError(f"Tabs not found: {missing_tabs}")

    frames=[]

    for tab in selected_tabs:
        df=pd.read_excel(
            xlsx_path,
            sheet_name=tab
        )

        missing=[
            column for column in required
            if column not in df.columns
        ]

        if missing:
            raise ValueError(
                f"Tab {tab} is missing columns: {missing}"
            )

        df=df[required].copy()
        df["cohort_state"]=str(tab)
        df["yr_qtr"]=df["yr_qtr"].astype(str)
        df["state"]=df["state"].astype(str)
        df["sector"]=df["sector"].astype(str)

        for metric in metrics:
            df[metric]=pd.to_numeric(
                df[metric],
                errors="coerce"
            )

        frames.append(df)

    data=pd.concat(
        frames,
        ignore_index=True
    )

    app_data=data.to_json(
        orient="records"
    ).replace("</","<\\/")

    cohorts=json.dumps(
        [str(tab) for tab in selected_tabs],
        separators=(",",":")
    )

    html="""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Top States and Sectors</title>
<style>
body{
font-family:Arial,sans-serif;
margin:0;
background:#f5f6f8;
color:#202124
}
header{
background:#fff;
border-bottom:1px solid #ddd;
padding:20px 28px
}
h1{
margin:0 0 16px;
font-size:25px
}
.controls{
display:flex;
gap:18px;
flex-wrap:wrap
}
.control{
display:flex;
flex-direction:column;
gap:5px
}
label{
font-size:13px;
font-weight:600;
color:#555
}
select{
min-width:180px;
padding:9px;
border:1px solid #bbb;
border-radius:5px;
background:#fff
}
.summary{
padding:16px 28px 0;
font-size:14px;
color:#555
}
.dashboard{
display:grid;
grid-template-columns:1fr 1fr;
gap:24px;
padding:20px 28px 30px
}
.panel{
background:#fff;
border:1px solid #ddd;
border-radius:8px;
overflow:hidden
}
.panel h2{
margin:0;
padding:16px 18px;
font-size:19px;
border-bottom:1px solid #ddd
}
.table-wrap{
overflow-x:auto
}
table{
width:100%;
border-collapse:collapse
}
th,td{
padding:13px 16px;
border-bottom:1px solid #e5e5e5;
text-align:left
}
th{
background:#f4f5f7;
font-size:13px;
color:#555
}
td.rank{
width:45px;
font-weight:600;
color:#555
}
td.value,th.value{
text-align:right;
font-variant-numeric:tabular-nums
}
tbody tr:last-child td{
border-bottom:none
}
tbody tr:hover{
background:#f7f9ff
}
.empty{
padding:20px;
color:#777
}
@media(max-width:750px){
.dashboard{
grid-template-columns:1fr
}
}
</style>
</head>
<body>
<header>
<h1>Top States and Sectors</h1>

<div class="controls">
<div class="control">
<label for="cohort">Cohort state</label>
<select id="cohort"></select>
</div>

<div class="control">
<label for="quarter">Quarter</label>
<select id="quarter"></select>
</div>

<div class="control">
<label for="metric">Rank by metric</label>
<select id="metric">
<option value="count">Count</option>
<option value="mean_wage">Mean Wage</option>
<option value="median_wage">Median Wage</option>
<option value="percentile_25">Percentile 25</option>
<option value="percentile_75">Percentile 75</option>
</select>
</div>
</div>
</header>

<div class="summary" id="summary"></div>

<main class="dashboard">
<section class="panel">
<h2>Top 5 States</h2>
<div class="table-wrap">
<table aria-label="Top five states">
<thead>
<tr>
<th>Rank</th>
<th>State</th>
<th class="value" id="stateMetricHeader">Metric</th>
</tr>
</thead>
<tbody id="stateTable"></tbody>
</table>
</div>
</section>

<section class="panel">
<h2>Top 5 Sectors</h2>
<div class="table-wrap">
<table aria-label="Top five sectors">
<thead>
<tr>
<th>Rank</th>
<th>Sector</th>
<th class="value" id="sectorMetricHeader">Metric</th>
</tr>
</thead>
<tbody id="sectorTable"></tbody>
</table>
</div>
</section>
</main>

<script>
const rows=__DATA__;
const cohorts=__COHORTS__;

const cohort=document.getElementById("cohort");
const quarter=document.getElementById("quarter");
const metric=document.getElementById("metric");
const summary=document.getElementById("summary");
const stateTable=document.getElementById("stateTable");
const sectorTable=document.getElementById("sectorTable");
const stateMetricHeader=document.getElementById("stateMetricHeader");
const sectorMetricHeader=document.getElementById("sectorMetricHeader");

function addOption(select,value,label){
const option=document.createElement("option");
option.value=value;
option.textContent=label;
select.appendChild(option);
}

cohorts.forEach(
value=>addOption(cohort,value,value)
);

function naturalSort(a,b){
return a.localeCompare(
b,
undefined,
{
numeric:true,
sensitivity:"base"
}
);
}

function updateQuarters(){
const previous=quarter.value;

const quarters=[
...new Set(
rows
.filter(
row=>row.cohort_state===cohort.value
)
.map(
row=>row.yr_qtr
)
)
].sort(naturalSort);

quarter.replaceChildren();

quarters.forEach(
value=>addOption(quarter,value,value)
);

if(quarters.includes(previous)){
quarter.value=previous;
}
}

function aggregate(data,groupField,metricName){
const groups=new Map();

data.forEach(row=>{
const groupName=String(row[groupField]);
const countValue=Number(row.count)||0;
const metricValue=Number(row[metricName]);

if(!groups.has(groupName)){
groups.set(
groupName,
{
name:groupName,
count:0,
weightedTotal:0,
weight:0
}
);
}

const group=groups.get(groupName);
group.count+=countValue;

if(
metricName!=="count" &&
Number.isFinite(metricValue)
){
if(countValue>0){
group.weightedTotal+=metricValue*countValue;
group.weight+=countValue;
}else{
group.weightedTotal+=metricValue;
group.weight+=1;
}
}
});

return [...groups.values()]
.map(group=>({
name:group.name,
value:
metricName==="count"
?group.count
:group.weight>0
?group.weightedTotal/group.weight
:null
}))
.filter(
group=>
group.value!==null &&
Number.isFinite(group.value)
)
.sort(
(a,b)=>b.value-a.value
)
.slice(0,5);
}

function formatValue(value,metricName){
if(metricName==="count"){
return value.toLocaleString(
undefined,
{
maximumFractionDigits:0
}
);
}

return value.toLocaleString(
undefined,
{
style:"currency",
currency:"USD",
minimumFractionDigits:0,
maximumFractionDigits:0
}
);
}

function renderTable(
tableElement,
records,
metricName
){
tableElement.replaceChildren();

if(records.length===0){
const row=document.createElement("tr");
const cell=document.createElement("td");

cell.colSpan=3;
cell.className="empty";
cell.textContent="No data available";

row.appendChild(cell);
tableElement.appendChild(row);

return;
}

records.forEach((record,index)=>{
const row=document.createElement("tr");
const rankCell=document.createElement("td");
const nameCell=document.createElement("td");
const valueCell=document.createElement("td");

rankCell.className="rank";
valueCell.className="value";

rankCell.textContent=index+1;
nameCell.textContent=record.name;
valueCell.textContent=formatValue(
record.value,
metricName
);

row.appendChild(rankCell);
row.appendChild(nameCell);
row.appendChild(valueCell);

tableElement.appendChild(row);
});
}

function draw(){
const metricName=metric.value;
const metricLabel=
metric.options[metric.selectedIndex].text;

const selected=rows.filter(
row=>
row.cohort_state===cohort.value &&
row.yr_qtr===quarter.value
);

const topStates=aggregate(
selected,
"state",
metricName
);

const topSectors=aggregate(
selected,
"sector",
metricName
);

stateMetricHeader.textContent=metricLabel;
sectorMetricHeader.textContent=metricLabel;

summary.textContent=
"Cohort: "+
cohort.value+
" | Quarter: "+
quarter.value+
" | Ranked by: "+
metricLabel;

renderTable(
stateTable,
topStates,
metricName
);

renderTable(
sectorTable,
topSectors,
metricName
);
}

cohort.addEventListener(
"change",
()=>{
updateQuarters();
draw();
}
);

quarter.addEventListener(
"change",
draw
);

metric.addEventListener(
"change",
draw
);

updateQuarters();
draw();
</script>
</body>
</html>"""

    html=html.replace(
        "__DATA__",
        app_data
    ).replace(
        "__COHORTS__",
        cohorts
    )

    output_path=Path(
        output_html
    ).resolve()

    output_path.write_text(
        html,
        encoding="utf-8"
    )

    print(f"Created: {output_path}")

    return output_path


