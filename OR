from pathlib import Path
import json
import pandas as pd
from plotly.offline import get_plotlyjs

def create_state_sector_sankey(
    xlsx_path,
    output_html="state_sector_sankey.html",
    tabs=None
):
    metrics=[
        "count",
        "mean_wage",
        "median_wage",
        "percentile_25",
        "percentile_75"
    ]
    required=["yr_qtr","state","sector"]+metrics
    workbook=pd.ExcelFile(xlsx_path)
    selected_tabs=workbook.sheet_names if tabs is None else tabs
    missing_tabs=[tab for tab in selected_tabs if tab not in workbook.sheet_names]
    if missing_tabs:
        raise ValueError(f"Tabs not found: {missing_tabs}")

    frames=[]
    for tab in selected_tabs:
        df=pd.read_excel(xlsx_path,sheet_name=tab)
        missing=[col for col in required if col not in df.columns]
        if missing:
            raise ValueError(f"Tab {tab} is missing columns: {missing}")
        df=df[required].copy()
        df["cohort_state"]=str(tab)
        df["yr_qtr"]=df["yr_qtr"].astype(str)
        df["state"]=df["state"].astype(str)
        df["sector"]=df["sector"].astype(str)
        for metric in metrics:
            df[metric]=pd.to_numeric(df[metric],errors="coerce")
        frames.append(df)

    data=pd.concat(frames,ignore_index=True)
    records=[]

    for (cohort,yr_qtr,state,sector),group in data.groupby(
        ["cohort_state","yr_qtr","state","sector"],
        dropna=False,
        sort=False
    ):
        count=group["count"].sum(min_count=1)
        row={
            "cohort_state":str(cohort),
            "yr_qtr":str(yr_qtr),
            "state":str(state),
            "sector":str(sector),
            "count":None if pd.isna(count) else float(count)
        }
        weights=pd.to_numeric(group["count"],errors="coerce").fillna(0)
        for metric in metrics[1:]:
            values=pd.to_numeric(group[metric],errors="coerce")
            valid=values.notna()
            if not valid.any():
                row[metric]=None
            elif weights[valid].sum()>0:
                row[metric]=float(
                    (values[valid]*weights[valid]).sum()/weights[valid].sum()
                )
            else:
                row[metric]=float(values[valid].mean())
        records.append(row)

    app_data=json.dumps(records,separators=(",",":"),allow_nan=False)
    cohort_options="".join(
        f'<option value="{tab}">{tab}</option>' for tab in selected_tabs
    )
    metric_options="".join(
        f'<option value="{metric}">{metric.replace("_"," ").title()}</option>'
        for metric in metrics
    )
    plotly_js=get_plotlyjs()

    html=f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>State to Sector Sankey</title>
<script>{plotly_js}</script>
<style>
body{{font-family:Arial,sans-serif;margin:0;background:#f7f8fa;color:#202124}}
header{{background:#fff;border-bottom:1px solid #ddd;padding:18px 24px}}
h1{{margin:0 0 14px;font-size:24px}}
.controls{{display:flex;gap:18px;flex-wrap:wrap}}
.control{{display:flex;flex-direction:column;gap:5px}}
label{{font-size:13px;font-weight:600;color:#555}}
select{{min-width:170px;padding:8px;border:1px solid #bbb;border-radius:5px;background:#fff}}
#chart{{height:calc(100vh - 130px);min-height:600px}}
</style>
</head>
<body>
<header>
<h1>State to Sector Flow</h1>
<div class="controls">
<div class="control">
<label for="cohort">Cohort state</label>
<select id="cohort">{cohort_options}</select>
</div>
<div class="control">
<label for="quarter">Quarter</label>
<select id="quarter"></select>
</div>
<div class="control">
<label for="metric">Metric</label>
<select id="metric">{metric_options}</select>
</div>
</div>
</header>
<div id="chart"></div>
<script>
const rows={app_data};
const cohort=document.getElementById("cohort");
const quarter=document.getElementById("quarter");
const metric=document.getElementById("metric");

function naturalSort(a,b){{
return a.localeCompare(b,undefined,{{numeric:true,sensitivity:"base"}});
}}

function colorFor(text,alpha=1){{
let hash=0;
for(let i=0;i<text.length;i++) hash=text.charCodeAt(i)+((hash<<5)-hash);
const hue=Math.abs(hash)%360;
return `hsla(${{hue}},65%,48%,${{alpha}})`;
}}

function updateQuarters(){{
const values=[...new Set(
rows.filter(r=>r.cohort_state===cohort.value).map(r=>r.yr_qtr)
)].sort(naturalSort);
const previous=quarter.value;
quarter.innerHTML=values.map(
v=>`<option value="${{v}}">${{v}}</option>`
).join("");
if(values.includes(previous)) quarter.value=previous;
}}

function draw(){{
const selected=rows.filter(r=>
r.cohort_state===cohort.value &&
r.yr_qtr===quarter.value &&
r[metric.value]!==null &&
Number(r[metric.value])>0
);
const states=[...new Set(selected.map(r=>r.state))].sort(naturalSort);
const sectors=[...new Set(selected.map(r=>r.sector))].sort(naturalSort);
const labels=[...states,...sectors];
const stateIndex=Object.fromEntries(states.map((v,i)=>[v,i]));
const sectorIndex=Object.fromEntries(
sectors.map((v,i)=>[v,states.length+i])
);
const source=selected.map(r=>stateIndex[r.state]);
const target=selected.map(r=>sectorIndex[r.sector]);
const values=selected.map(r=>Number(r[metric.value]));
const customdata=selected.map(r=>[
r.state,
r.sector,
r.cohort_state,
r.yr_qtr
]);
const nodeColors=[
...states.map(s=>colorFor(s)),
...sectors.map(()=>"#aeb4bc")
];
const linkColors=selected.map(r=>colorFor(r.state,.35));
const currency=metric.value!=="count";
const trace={{
type:"sankey",
orientation:"h",
arrangement:"snap",
valueformat:currency?",.2f":",.0f",
valuesuffix:currency?"":" workers",
node:{{
pad:14,
thickness:18,
line:{{color:"#555",width:.4}},
label:labels,
color:nodeColors,
hovertemplate:"%{{label}}<extra></extra>"
}},
link:{{
source:source,
target:target,
value:values,
color:linkColors,
customdata:customdata,
hovertemplate:
"Cohort: %{{customdata[2]}}<br>"+
"Quarter: %{{customdata[3]}}<br>"+
"State: %{{customdata[0]}}<br>"+
"Sector: %{{customdata[1]}}<br>"+
`${{metric.options[metric.selectedIndex].text}}: `+
(currency?"$":"")+"%{{value:,.2f}}<extra></extra>"
}}
}};
const layout={{
title:{{
text:`Cohort ${{cohort.value}}: State → Sector<br>`+
`<sup>${{quarter.value}} | ${{metric.options[metric.selectedIndex].text}}</sup>`,
x:.5
}},
font:{{size:12}},
paper_bgcolor:"#f7f8fa",
plot_bgcolor:"#f7f8fa",
margin:{{l:30,r:30,t:80,b:30}}
}};
Plotly.react("chart",[trace],layout,{{responsive:true,displaylogo:false}});
}}

cohort.addEventListener("change",()=>{{updateQuarters();draw()}});
quarter.addEventListener("change",draw);
metric.addEventListener("change",draw);
window.addEventListener("resize",()=>Plotly.Plots.resize("chart"));
updateQuarters();
draw();
</script>
</body>
</html>"""

    output_path=Path(output_html).resolve()
    output_path.write_text(html,encoding="utf-8")
    print(f"Created: {{output_path}}")
    return output_path



create_state_sector_sankey(
    xlsx_path="state_flows.xlsx",
    output_html="state_sector_sankey.html",
    tabs=["WI","IL","IA","MN","IN"]
)
