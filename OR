import pandas as pd
from sqlalchemy import text
from sqlalchemy.engine import Engine


def find_wage_statistics(
    engine: Engine,
    keys: pd.DataFrame,
) -> dict:
    """
    Find rows matching YR, QTR, STATE_CODE and calculate wage statistics.

    keys columns:
        YR, QTR, STATE_CODE
    """

    required = ["YR", "QTR", "STATE_CODE"]
    missing = set(required) - set(keys.columns)

    if missing:
        raise ValueError(f"Missing columns: {sorted(missing)}")

    if keys.empty:
        return {
            "number_found": 0,
            "mean_wage": None,
            "median_wage": None,
            "percentile_25": None,
            "percentile_75": None,
        }

    keys = keys[required].dropna().drop_duplicates()

    with engine.begin() as connection:
        connection.execute(text("""
            CREATE TEMP TABLE search_keys (
                yr         INTEGER NOT NULL,
                qtr        SMALLINT NOT NULL,
                state_code TEXT NOT NULL
            ) ON COMMIT DROP
        """))

        # Uses psycopg 3: postgresql+psycopg://
        dbapi_connection = connection.connection.driver_connection

        with dbapi_connection.cursor() as cursor:
            with cursor.copy("""
                COPY search_keys (yr, qtr, state_code)
                FROM STDIN
            """) as copy:
                for yr, qtr, state_code in keys.itertuples(
                    index=False,
                    name=None,
                ):
                    copy.write_row((
                        int(yr),
                        int(qtr),
                        str(state_code),
                    ))

        connection.execute(text("""
            CREATE INDEX search_keys_lookup_idx
            ON search_keys (yr, qtr, state_code)
        """))

        row = connection.execute(text("""
            SELECT
                COUNT(t.id) AS number_found,
                AVG(t.wage) AS mean_wage,
                PERCENTILE_CONT(0.50)
                    WITHIN GROUP (ORDER BY t.wage) AS median_wage,
                PERCENTILE_CONT(0.25)
                    WITHIN GROUP (ORDER BY t.wage) AS percentile_25,
                PERCENTILE_CONT(0.75)
                    WITHIN GROUP (ORDER BY t.wage) AS percentile_75
            FROM your_table AS t
            INNER JOIN search_keys AS k
                ON k.yr = t.yr
               AND k.qtr = t.qtr
               AND k.state_code = t.state_code
            WHERE t.wage IS NOT NULL
        """)).mappings().one()

    return {
        "number_found": row["number_found"],
        "mean_wage": (
            float(row["mean_wage"])
            if row["mean_wage"] is not None else None
        ),
        "median_wage": (
            float(row["median_wage"])
            if row["median_wage"] is not None else None
        ),
        "percentile_25": (
            float(row["percentile_25"])
            if row["percentile_25"] is not None else None
        ),
        "percentile_75": (
            float(row["percentile_75"])
            if row["percentile_75"] is not None else None
        ),
    }
